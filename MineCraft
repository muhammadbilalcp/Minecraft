      b.box(g,.08,.15,.08,0xeeeeee,-.22,1.38,.72); b.box(g,.08,.15,.08,0xeeeeee,.22,1.38,.72);
      b.box(g,.08,.08,.04,0x111111,-.14,1.15,.96,true); b.box(g,.08,.08,.04,0x111111,.14,1.15,.96,true);
      mob.legs = [b.limb(g,.2,.55,.2,br,-.22,.55,.4), b.limb(g,.2,.55,.2,br,.22,.55,.4), b.limb(g,.2,.55,.2,br,-.22,.55,-.4), b.limb(g,.2,.55,.2,br,.22,.55,-.4)];
      break; }
    case 'zombie': {
      const skin = 0x5f9a4a, shirt = 0x2f8f9f, pants = 0x35358a;
      mob.legs = [b.limb(g,.25,.75,.25,pants,-.14,.75,0), b.limb(g,.25,.75,.25,pants,.14,.75,0)];
      b.box(g,.55,.75,.3,shirt,0,1.125,0); b.box(g,.5,.5,.5,skin,0,1.75,0);
