/* ============================ PHYSICS ============================ */
function collides(pos){ return collidesBox(pos, PLAYER_RADIUS, PLAYER_HEIGHT); }
let moving = false;
function updatePhysics(dt){
  const fwd = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
  let f = (keys['KeyW']?1:0) - (keys['KeyS']?1:0) + joy.y;
  let s = (keys['KeyD']?1:0) - (keys['KeyA']?1:0) + joy.x;
  const mag = Math.hypot(f,s); if(mag > 1){ f/=mag; s/=mag; }
  const moveX = fwd.x*f + right.x*s, moveZ = fwd.z*f + right.z*s;
  const len = Math.hypot(moveX, moveZ);
  moving = len > 0.05 && player.onGround;

  const feetB = getBlock(Math.floor(player.pos.x), Math.floor(player.pos.y+0.4), Math.floor(player.pos.z));
  const inWater = feetB === BLOCK.WATER, inLava = feetB === BLOCK.LAVA, inLiq = inWater || inLava;
  const sprint = (keys['ShiftLeft'] || sprintToggle) && len > 0.05 && player.hunger > 3;
  player.sprinting = sprint;
  let speed = sprint ? SPRINT_SPEED : WALK_SPEED;
  if(inLiq) speed *= inLava ? 0.4 : 0.6;
  player.vel.x = moveX*speed; player.vel.z = moveZ*speed;

  player.vel.y += GRAVITY*(inLiq?0.25:1)*dt;
  if(player.vel.y < -30) player.vel.y = -30;
  const jump = keys['Space'] || touchJump;
  if(inLiq){ if(player.vel.y < -4) player.vel.y = -4; if(jump) player.vel.y = 4; }
  else if(jump && player.onGround){ player.vel.y = JUMP_SPEED; player.onGround = false; }

  const disp = new THREE.Vector3((player.vel.x+player.kb.x)*dt, player.vel.y*dt, (player.vel.z+player.kb.z)*dt);
  player.kb.multiplyScalar(Math.max(0, 1 - 6*dt));
  player.pos.x += disp.x; if(collides(player.pos)) player.pos.x -= disp.x;
  player.pos.z += disp.z; if(collides(player.pos)) player.pos.z -= disp.z;
  player.pos.y += disp.y;
  if(collides(player.pos)){
    player.pos.y -= disp.y;
    if(disp.y < 0){
      if(!player.onGround){ const fall = player.peak - player.pos.y; if(fall > 3.5 && !inLiq) damagePlayer(Math.floor(fall-3), null, true); }
      player.onGround = true;
    }
    player.vel.y = 0;
  } else player.onGround = false;
  if(player.onGround || inLiq) player.peak = player.pos.y; else player.peak = Math.max(player.peak, player.pos.y);

  if(inLava){ player.lavaT += dt; if(player.lavaT > 0.5){ player.lavaT = 0; damagePlayer(4, null, true); } } else player.lavaT = 0;
  if(player.pos.y < -10) damagePlayer(999, null, true);
}

/* ============================ SURVIVAL ============================ */
const flashEl = $('damageFlash');
function damagePlayer(amount, src, force){
  if(!player.alive) return;
  if(!force && player.invuln > 0) return;
  if(!force) player.invuln = 0.5;
  if(!force){ const ap = armorPoints(); if(ap > 0) amount = Math.max(1, Math.round(amount*(1 - Math.min(0.8, ap*0.04)))); }
  player.health -= amount;
  flashEl.style.opacity = 1; setTimeout(()=>flashEl.style.opacity = 0, 80);
  sfx('hurt');
  if(src){
    const dx = player.pos.x - src.x, dz = player.pos.z - src.z, l = Math.hypot(dx,dz) || 1;
    player.kb.x += dx/l*8; player.kb.z += dz/l*8; player.vel.y = 5; player.onGround = false;
  }
  if(player.health <= 0){
    player.health = 0; player.alive = false; mouseHeld = false; touchAtk = false; touchUse = false;
    $('deathScreen').style.display = 'flex';
    if(document.pointerLockElement) document.exitPointerLock();
  }
  updateHudUI();
}
function respawn(){
  player.health = player.maxHealth; player.hunger = player.maxHunger; player.air = 10; player.alive = true; player.invuln = 2;
  player.vel.set(0,0,0); player.kb.set(0,0,0);
  if(currentDim !== 'overworld') switchDim('overworld');
  for(let dx=-1;dx<=1;dx++) for(let dz=-1;dz<=1;dz++) getChunk(Math.floor(spawnPos.x/16)+dx, Math.floor(spawnPos.z/16)+dz, true);
  player.pos.copy(spawnPos); player.peak = spawnPos.y; player.portalCd = 3;
  $('deathScreen').style.display = 'none';
  runLoading('Respawning');
  lockPointer();
}
function updateSurvival(dt){
  if(!player.alive) return;
  player.invuln = Math.max(0, player.invuln - dt);
  player.hungerTimer += dt * (player.sprinting ? 2.2 : 1);
  if(player.hungerTimer > 10){ player.hungerTimer = 0; if(player.hunger > 0) player.hunger -= 1; }
  if(player.hunger <= 0){
    player.damageTimer += dt;
    if(player.damageTimer > 3){ player.damageTimer = 0; damagePlayer(1, null, true); }
  } else if(player.hunger >= 14){
    player.regenTimer += dt;
    if(player.regenTimer > 4 && player.health < player.maxHealth){ player.regenTimer = 0; player.health = Math.min(player.maxHealth, player.health+1); }
  }
  // air
  const headB = getBlock(Math.floor(player.pos.x), Math.floor(player.pos.y+PLAYER_HEIGHT*0.9), Math.floor(player.pos.z));
  if(headB === BLOCK.WATER){
    player.airT += dt;
    if(player.airT >= 1){ player.airT = 0; if(player.air > 0) player.air--; else damagePlayer(2, null, true); }
  } else { player.airT = 0; player.air = Math.min(10, player.air + dt*6); }
  updateHudUI();
}

