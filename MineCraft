      b.box(g,2.2,1.5,4.2,dark,0,0,0); b.box(g,1.1,1.0,1.8,dark,0,.35,2.9); b.box(g,1.5,1.1,1.9,mid,0,.6,4.3);
      b.box(g,1.0,.5,1.1,mid,0,.4,5.4); b.box(g,.9,.25,1.4,dark,0,.1,4.6);
