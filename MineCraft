function joinWorld(codeText){
  const code = (codeText||'').trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
  if(code.length < 3){ toast('Enter the room code first', 2000); return; }
  if(typeof Peer === 'undefined'){ toast('Multiplayer library did not load. Check your internet connection.', 4500); return; }
  closeNet();
  $('menu').style.display = 'none'; loadingBusy = true; showLoading(true, 'Connecting...');
  let done = false, to = null;
  const fail = msg => { if(done) return; done = true; clearTimeout(to); closeNet(); loadingBusy = false; showLoading(false); $('menu').style.display = 'flex'; toast(msg, 4000); };
  try{ peer = new Peer(); }catch(e){ fail('Could not start networking'); return; }
  to = setTimeout(() => fail('Could not reach that room. Check the code and that the host is online.'), 15000);
  peer.on('error', e => fail(e && e.type === 'peer-unavailable' ? 'No room with that code' : 'Network error: ' + ((e && e.type) || e)));
  peer.on('open', id => {
    myId = id; myName = 'Player-' + id.slice(-4);
    hostConn = peer.connect('vsv-' + code, { reliable:true });
    netRole = 'client'; roomCode = code;
    hostConn.on('data', d => {
      if(d && d.t === 'init'){ if(!done){ done = true; clearTimeout(to); joinInit(d); } }
      else handleNet(hostConn, d);
    });
    hostConn.on('close', () => { if(netRole === 'client'){ closeNet(); toast('Disconnected from host. You can keep playing this world.', 5000); } });
  });
}
