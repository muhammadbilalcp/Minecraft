/* ============================ RAYCAST ============================ */
function raycastVoxel(origin, dir, maxDist){
  let x = Math.floor(origin.x), y = Math.floor(origin.y), z = Math.floor(origin.z);
  const stepX = dir.x>0?1:-1, stepY = dir.y>0?1:-1, stepZ = dir.z>0?1:-1;
  const tDeltaX = dir.x!==0 ? Math.abs(1/dir.x) : Infinity;
  const tDeltaY = dir.y!==0 ? Math.abs(1/dir.y) : Infinity;
  const tDeltaZ = dir.z!==0 ? Math.abs(1/dir.z) : Infinity;
  function frac(v, step){ return step>0 ? (1-(v-Math.floor(v))) : (v-Math.floor(v)); }
  let tMaxX = tDeltaX * frac(origin.x, stepX), tMaxY = tDeltaY * frac(origin.y, stepY), tMaxZ = tDeltaZ * frac(origin.z, stepZ);
  let dist = 0, lastNormal = [0,0,0];
  for(let i=0;i<64;i++){
    const b = getBlock(x,y,z);
    if(b !== 0 && b !== 7 && b !== 12 && b !== 15 && b !== 17) return { x,y,z, block:b, normal:lastNormal, dist };
    if(tMaxX < tMaxY && tMaxX < tMaxZ){ x += stepX; dist = tMaxX; tMaxX += tDeltaX; lastNormal=[-stepX,0,0]; }
    else if(tMaxY < tMaxZ){ y += stepY; dist = tMaxY; tMaxY += tDeltaY; lastNormal=[0,-stepY,0]; }
    else { z += stepZ; dist = tMaxZ; tMaxZ += tDeltaZ; lastNormal=[0,0,-stepZ]; }
    if(dist > maxDist) return null;
  }
  return null;
}
function getLookDir(){ const dir = new THREE.Vector3(0,0,-1); dir.applyEuler(new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ')); return dir; }
function eyePos(){ return new THREE.Vector3(player.pos.x, player.pos.y+PLAYER_HEIGHT*0.9, player.pos.z); }
function rayBox(o, d, mn, mx){
  let tmin = 0, tmax = 1e9;
  for(const a of ['x','y','z']){
    if(Math.abs(d[a]) < 1e-8){ if(o[a] < mn[a] || o[a] > mx[a]) return null; }
    else {
      let t1 = (mn[a]-o[a])/d[a], t2 = (mx[a]-o[a])/d[a];
      if(t1 > t2){ const s=t1; t1=t2; t2=s; }
      tmin = Math.max(tmin,t1); tmax = Math.min(tmax,t2);
      if(tmin > tmax) return null;
    }
  }
  return tmin;
}

