  for(let y=0;y<TILE;y++) for(let x=0;x<TILE;x++){
    const p = fn(x,y,r), o = (y*TILE+x)*4;
    img.data[o] = clamp255(p[0]); img.data[o+1] = clamp255(p[1]); img.data[o+2] = clamp255(p[2]);
    img.data[o+3] = p[3]===undefined ? 255 : p[3];
  }
  actx.putImageData(img, (i%ATLAS_N)*TILE, Math.floor(i/ATLAS_N)*TILE);
}
function stoneColor(x,y,r){ const k = nz(r,26); const c = Math.sin(x*1.7+y*0.9)*Math.cos(y*1.3-x*0.4)*9; return [128+k+c, 128+k+c, 130+k+c]; }
