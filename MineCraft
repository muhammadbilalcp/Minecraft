  const seen = new Set();
  for(const e of d.list){
    seen.add(e[0]);
    let m = ghostMobs.get(e[0]);
    if(!m){
      m = spawnMob(MOB_TYPES[e[1]], e[2], e[3], e[4]);
      m.ghost = true; m.id = e[0]; ghostMobs.set(e[0], m);
      if(m.type === 'dragon') m.group.rotation.order = 'YXZ';
    }
    m.tx = e[2]; m.ty = e[3]; m.tz = e[4]; m.tyaw = e[5]; m.hp = e[6];
  }
  for(const pair of Array.from(ghostMobs)){ if(!seen.has(pair[0])){ removeMob(pair[1]); ghostMobs.delete(pair[0]); } }
}
