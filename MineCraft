  <div class="tbtn" id="btnInv"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" fill="#fff"/><rect x="13" y="4" width="7" height="7" fill="#fff"/><rect x="4" y="13" width="7" height="7" fill="#fff"/><rect x="13" y="13" width="7" height="7" fill="#fff"/></svg></div>
</div>
<div class="tbtn" id="btnFull" title="Fullscreen"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round"/></svg></div>

