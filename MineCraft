      for(let y=0; y<WORLD_HEIGHT; y++){
        const b = data[idx(x,y,z)];
        if(b === 0) continue;

        if(isPlant(b)){
          const uv = tileUV(PLANT_TILE[b]);
          const jx = (hash2(ox+x, oz+z)-0.5)*0.3, jz = (hash2(oz+z, ox+x+7)-0.5)*0.3;
          const br = 0.88 + hash2(ox+x+3, oz+z+9)*0.12;
          const q = [[0,0],[1,0],[1,1],[0,1]];
          const uvs = q.map(p => [p[0]?uv[2]:uv[0], p[1]?uv[3]:uv[1]]);
          const cs = [br,br,br,br];
          pushQuad(P, [[x+jx,y,z+jz],[x+1+jx,y,z+1+jz],[x+1+jx,y+1,z+1+jz],[x+jx,y+1,z+jz]], uvs, cs, false, [0,1,0], [0,0,1,1]);
          pushQuad(P, [[x+1+jx,y,z+jz],[x+jx,y,z+1+jz],[x+jx,y+1,z+1+jz],[x+1+jx,y+1,z+jz]], uvs, cs, false, [0,1,0], [0,0,1,1]);
          continue;
        }

        const isWater = (b === 7), isPortal = (b === 15 || b === 17), isEmit = (b === 12 || b === 13);
        const above = get(x,y+1,z);
        const lowerTop = isWater && above !== 7;
        let light = 1;
        if(depthLight && !isEmit){ const d = Math.max(0, L0 - y - 1); light = Math.max(0.3, 1 - d*0.13); }

        for(let f=0; f<6; f++){
          const face = FACES[f], d = face.dir;
          const nb = get(x+d[0], y+d[1], z+d[2]);
          let skip;
          if(isWater || isPortal) skip = (nb !== 0 && !isPlant(nb));
          else if(b === 5) skip = (nb === 5 || isSolid(nb));
          else if(b === 12) skip = (nb === 12 || (isSolid(nb) && nb !== 5));
          else skip = (isSolid(nb) && nb !== 5);
          if(skip) continue;

          const tiles = isWater ? [0,0,0] : BLOCK_TILES[b];
          const tile = f===2 ? tiles[0] : (f===3 ? tiles[1] : tiles[2]);
          const uv = tileUV(tile);
          const shade = FACE_SHADE_L[f];
          const jit = ((b===1 && f===2) || b===5) ? 0.9 + 0.2*hash2(ox+x+y*7.3, oz+z+y*3.1) : 1;
          const pts = [], uvs = [], cols = [], ao = [];
          const [t1,t2] = TANGENTS[f];
          const bp = [x+d[0], y+d[1], z+d[2]];

          for(let k=0;k<4;k++){
            const cc = face.corners[k];
            let py = y + cc[1];
            if(lowerTop && cc[1]===1) py = y + 0.875;
            pts.push([x+cc[0], py, z+cc[2]]);
            if(isWater){
              uvs.push([FACE_UVC[f][k][0], FACE_UVC[f][k][1]]);
              cols.push(Math.max(0.55,light)); ao.push(3);
            } else {
              const cu = FACE_UVC[f][k];
              uvs.push([cu[0]?uv[2]:uv[0], cu[1]?uv[3]:uv[1]]);
              if(isEmit){ cols.push(0.82+0.18*shade); ao.push(3); }
              else if(isPortal){ cols.push(1); ao.push(3); }
              else {
                const d1 = cc[t1]?1:-1, d2 = cc[t2]?1:-1;
                const a = bp.slice(), bb = bp.slice(), cn = bp.slice();
                a[t1] += d1; bb[t2] += d2; cn[t1] += d1; cn[t2] += d2;
                const s1 = occ(a[0],a[1],a[2]), s2 = occ(bb[0],bb[1],bb[2]), s3 = occ(cn[0],cn[1],cn[2]);
                const v = (s1 && s2) ? 0 : 3 - (s1+s2+s3);
                ao.push(v);
                cols.push(AO_BRIGHT[v]*shade*light*jit);
              }
            }
          }
          const flip = ao[0]+ao[2] < ao[1]+ao[3];
          pushQuad(isWater ? W : (isPortal ? Q : (isEmit ? E : S)), pts, uvs, cols, flip, d);
        }
      }
    }
  }

  disposeMeshes(c);
  const add = (buf, mat, key, order) => {
    if(!buf.n) return;
    const m = new THREE.Mesh(bufToGeo(buf), mat);
    if(key === 'mesh'){ m.castShadow = true; m.receiveShadow = true; }
