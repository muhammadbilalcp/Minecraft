function handleNet(c, d){
  if(!d) return;
  switch(d.t){
    case 'p': upsertRemote(d); if(netRole === 'host') sendAll(d, c); break;
    case 'bs':
      netApply = true;
      for(const e of d.l) withDim(DIM_IDS[e[0]], () => setBlock(e[1], e[2], e[3], e[4]));
      netApply = false;
      if(netRole === 'host') sendAll(d, c);
      break;
    case 'm': if(netRole === 'client') applyMobs(d); break;
    case 'h':
      if(netRole === 'host'){
        const m = mobs.find(q => q.id === d.id);
        if(m && !m.dead && !m.ghost){ dropTarget = c; damageMob(m, d.dmg, { x:d.x, z:d.z }); dropTarget = null; }
      }
