/* ============================ DAY / NIGHT / DIMENSION LOOK ============================ */
const C_DAY_TOP = new THREE.Color(0x4f97e6), C_DAY_HOR = new THREE.Color(0xbfe2ff);
const C_NIGHT_TOP = new THREE.Color(0x02030c), C_NIGHT_HOR = new THREE.Color(0x0a0f2c);
const C_DUSK = new THREE.Color(0xff8a4a);
const C_LIGHT_NIGHT = new THREE.Color(0.26,0.32,0.6), C_WHITE = new THREE.Color(1,1,1), C_WARM = new THREE.Color(1,0.8,0.62);
const tmpTop = new THREE.Color(), tmpHor = new THREE.Color();
function smoothstep(a,b,x){ const t = Math.max(0,Math.min(1,(x-a)/(b-a))); return t*t*(3-2*t); }
let underwater = false, inLavaCam = false, sunHeight = 1;
const sunVec = new THREE.Vector3(0,1,0), sunCol = new THREE.Color(1,0.95,0.85);
const C_SUNW = new THREE.Color(1,0.95,0.85), C_SUNDUSK = new THREE.Color(1,0.55,0.28);

function updateDayNight(dt){
  dayTime += dt;
  if(dayTime > DAY_LENGTH) dayTime -= DAY_LENGTH;
  const dimLabel = { overworld:'Overworld', nether:'The Nether', end:'The End' }[currentDim];
  $('dimLabel').textContent = dimLabel;
  let sunAmt = 0, glow = 0; const sunDirV = new THREE.Vector3(0,1,0), sunColV = new THREE.Color(1,0.96,0.85);
  let sunI = 0, ambK = 0.95, ambG = 0.7, fillI = 0;

  if(currentDim === 'overworld'){
    const angle = (dayTime / DAY_LENGTH) * Math.PI * 2;
    const sunH = Math.sin(angle); sunHeight = sunH;
    const dayF = smoothstep(-0.12, 0.28, sunH);
    const duskF = Math.max(0, 1 - Math.abs(sunH)/0.3);
    tmpTop.copy(C_NIGHT_TOP).lerp(C_DAY_TOP, dayF).lerp(C_DUSK, duskF*0.12);
    tmpHor.copy(C_NIGHT_HOR).lerp(C_DAY_HOR, dayF).lerp(C_DUSK, duskF*0.75);
    lightColor.copy(C_LIGHT_NIGHT).lerp(C_WHITE, dayF).lerp(C_WARM, duskF*0.4*dayF + duskF*0.15);
    const sd = new THREE.Vector3(Math.cos(angle), Math.sin(angle), 0.25).normalize();
    ambK = 0.66 + 0.34*(1-dayF); ambG = 0.4 + 0.3*(1-dayF);
    if(sunH > -0.05){ sunVec.copy(sd); sunI = 0.74*smoothstep(-0.02,0.3,sunH); sunCol.copy(C_SUNW).lerp(C_SUNDUSK, Math.min(1,duskF*1.2)); }
    else { sunVec.copy(sd).negate(); sunI = 0.24*smoothstep(0.0,0.3,-sunH); sunCol.set(0x8fa6ff); }
    sunMesh.visible = moonMesh.visible = true;
    sunMesh.position.copy(camera.position).addScaledVector(sd, 300);
    moonMesh.position.copy(camera.position).addScaledVector(sd, -300);
    sunMesh.lookAt(camera.position); moonMesh.lookAt(camera.position);
    sunMesh.material.opacity = Math.min(1, dayF*3 + 0.3*duskF);
    moonMesh.material.opacity = 1 - dayF;
    starGroup.rotation.z = angle;
    starGroup.userData.mat.opacity = Math.max(0, 1 - dayF*1.6);
    if(sunH > -0.02){ sunDirV.copy(sd); sunAmt = dayF; sunColV.set(1,0.96,0.85).lerp(C_DUSK, duskF*0.55); }
    else { sunDirV.copy(sd).negate(); sunAmt = 0.16*(1-dayF); sunColV.set(0.55,0.65,1.0); }
    glow = smoothstep(-0.2, 0.25, sunH);
    skyMat.uniforms.sunDir.value.copy(sd);
    cloudTop.visible = cloudBottom.visible = true;
    $('timeLabel').textContent = 'Time: ' + (sunH < -0.05 ? 'Night' : (sunH < 0.25 ? 'Dusk/Dawn':'Day'));
  } else if(currentDim === 'nether'){
    sunHeight = 1;
    tmpTop.set(0x200505); tmpHor.set(0x2e0707);
    lightColor.set(1, 0.74, 0.6); fillI = 0.45;
    sunMesh.visible = moonMesh.visible = false; cloudTop.visible = cloudBottom.visible = false;
    starGroup.userData.mat.opacity = 0;
    $('timeLabel').textContent = 'Time: --';
  } else {
    sunHeight = 1;
    tmpTop.set(0x07030f); tmpHor.set(0x1c1032);
    lightColor.set(0.88, 0.82, 0.98); fillI = 0.4;
    sunMesh.visible = moonMesh.visible = false; cloudTop.visible = cloudBottom.visible = false;
    starGroup.userData.mat.opacity = 1; starGroup.rotation.z += dt*0.002;
    $('timeLabel').textContent = 'Time: --';
  }
  worldUniforms.uSunDir.value.copy(sunDirV); worldUniforms.uSunCol.value.copy(sunColV); worldUniforms.uSunAmt.value = sunAmt; worldUniforms.uAmb.value.copy(lightColor);
  skyMat.uniforms.sunCol.value.copy(sunColV); skyMat.uniforms.glow.value = glow;
  skyMat.uniforms.topColor.value.copy(tmpTop);
  skyMat.uniforms.bottomColor.value.copy(tmpHor);
  scene.background.copy(tmpHor);
  if(inLavaCam) scene.fog.color.set(0xc83c00);
  else if(underwater) scene.fog.color.set(0x1b4aa8);
  else scene.fog.color.copy(tmpHor);
  for(const m of tintables) m.color.copy(lightColor);
  hemi.color.copy(lightColor).multiplyScalar(ambK);
  hemi.groundColor.copy(lightColor).multiplyScalar(ambG);
  sun.intensity = sunI; sun.color.copy(sunCol);
  fill.intensity = fillI; fill.color.copy(lightColor);
  const sx = Math.round(player.pos.x/2)*2, sy = Math.round(player.pos.y/2)*2, sz = Math.round(player.pos.z/2)*2;
  sun.target.position.set(sx, sy, sz);
  sun.position.set(sx + sunVec.x*120, sy + sunVec.y*120, sz + sunVec.z*120);
  sun.target.updateMatrixWorld();
  starGroup.position.copy(camera.position);
  skyMesh.position.copy(camera.position);
}

/* ============================ CHUNK STREAMING ============================ */
let unloadCounter = 0;
function updateChunks(maxBuild){
  const [pcx, pcz] = worldToChunk(player.pos.x, player.pos.z);
  const R = RENDER_DISTANCE;
  for(let dx=-R-1; dx<=R+1; dx++) for(let dz=-R-1; dz<=R+1; dz++) getChunk(pcx+dx, pcz+dz, true);
  const need = [];
  for(let dx=-R; dx<=R; dx++) for(let dz=-R; dz<=R; dz++){
    const c = getChunk(pcx+dx, pcz+dz, true);
    if(c.dirty) need.push([dx*dx+dz*dz, pcx+dx, pcz+dz]);
  }
  need.sort((a,b)=>a[0]-b[0]);
  const n = Math.min(maxBuild, need.length);
  for(let i=0;i<n;i++) buildChunkMesh(need[i][1], need[i][2]);
  if(++unloadCounter % 30 === 0){
    for(const key in chunks){
      const c = chunks[key];
      if(!c.mesh && !c.waterMesh && !c.plantMesh && !c.portalMesh && !c.emitMesh) continue;
      const [cx,cz] = key.split(',').map(Number);
      if(Math.abs(cx-pcx) > R+1 || Math.abs(cz-pcz) > R+1){ disposeMeshes(c); c.dirty = true; }
    }
  }
}

