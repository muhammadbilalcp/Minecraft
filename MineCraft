/* ============================ RNG + NOISE ============================ */
function rng32(seed){
  return function(){
    seed |= 0; seed = seed + 0x6D2B79F5 | 0;
    let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
function makeNoise(seed){
  function hash(x, y){ const n = Math.sin(x*127.1 + y*311.7 + seed*74.7) * 43758.5453123; return n - Math.floor(n); }
  function smoothN(x,y){
    const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    const u = xf*xf*(3-2*xf), v = yf*yf*(3-2*yf);
    const a = hash(xi,yi), b = hash(xi+1,yi), c = hash(xi,yi+1), d = hash(xi+1,yi+1);
    return a + (b-a)*u + (c-a)*v + (a-b-c+d)*u*v;
  }
  return function(x,y,octaves,scale,persistence){
    let total=0, freq=scale, amp=1, maxAmp=0;
    for(let i=0;i<octaves;i++){ total += smoothN(x*freq, y*freq)*amp; maxAmp += amp; amp *= persistence; freq *= 2; }
    return total/maxAmp;
  };
}
let noise2D = makeNoise(1337);
let WORLD_SEED = 1337;
function hash3(x,y,z,s){ const n = Math.sin(x*127.1 + y*311.7 + z*74.7 + s*19.3) * 43758.5453; return n - Math.floor(n); }
function noise3(x,y,z,s){
  const xi=Math.floor(x), yi=Math.floor(y), zi=Math.floor(z);
  let xf=x-xi, yf=y-yi, zf=z-zi;
  xf=xf*xf*(3-2*xf); yf=yf*yf*(3-2*yf); zf=zf*zf*(3-2*zf);
  const l = (a,b,t) => a+(b-a)*t;
  const c00=l(hash3(xi,yi,zi,s),hash3(xi+1,yi,zi,s),xf), c10=l(hash3(xi,yi+1,zi,s),hash3(xi+1,yi+1,zi,s),xf);
