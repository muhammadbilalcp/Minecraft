// touch controls
if(IS_TOUCH){
  const joyEl = $('joy'), knob = $('joyKnob'), look = $('lookZone');
  let joyId = null, jcx = 0, jcy = 0, lookId = null, lx = 0, ly = 0;
  function joyMove(t){
    let dx = t.clientX - jcx, dy = t.clientY - jcy; const m = Math.hypot(dx,dy), R = 50;
    if(m > R){ dx = dx/m*R; dy = dy/m*R; }
    knob.style.transform = 'translate('+dx+'px,'+dy+'px)';
    let jx = dx/R, jy = -dy/R;
    if(Math.hypot(jx,jy) < 0.15){ jx = 0; jy = 0; }
    joy.x = jx; joy.y = jy;
  }
  joyEl.addEventListener('touchstart', e => {
    e.preventDefault(); audio();
    const t = e.changedTouches[0]; joyId = t.identifier;
    const r = joyEl.getBoundingClientRect(); jcx = r.left + r.width/2; jcy = r.top + r.height/2;
    joyMove(t);
  }, {passive:false});
  look.addEventListener('touchstart', e => {
    e.preventDefault(); audio();
    const t = e.changedTouches[0]; lookId = t.identifier; lx = t.clientX; ly = t.clientY;
  }, {passive:false});
  document.addEventListener('touchmove', e => {
    for(const t of e.changedTouches){
      if(t.identifier === joyId){ joyMove(t); }
      else if(t.identifier === lookId && isActive()){
        player.yaw -= (t.clientX - lx) * 0.0055;
        player.pitch -= (t.clientY - ly) * 0.0055;
        player.pitch = Math.max(-Math.PI/2+0.01, Math.min(Math.PI/2-0.01, player.pitch));
        lx = t.clientX; ly = t.clientY;
      }
    }
    if(!uiOpen && menuHidden) e.preventDefault();
  }, {passive:false});
  function endTouch(e){
    for(const t of e.changedTouches){
      if(t.identifier === joyId){ joyId = null; joy.x = joy.y = 0; knob.style.transform = 'translate(0,0)'; }
      if(t.identifier === lookId){ lookId = null; }
    }
  }
  document.addEventListener('touchend', endTouch);
  document.addEventListener('touchcancel', endTouch);

  function hold(el, down, up){
    el.addEventListener('touchstart', e => { e.preventDefault(); audio(); el.classList.add('on'); down(); }, {passive:false});
    const end = e => { e.preventDefault(); el.classList.remove('on'); up(); };
    el.addEventListener('touchend', end, {passive:false});
    el.addEventListener('touchcancel', end, {passive:false});
  }
  hold($('btnAtk'), ()=>{ touchAtk = true; }, ()=>{ touchAtk = false; });
  hold($('btnJump'), ()=>{ touchJump = true; }, ()=>{ touchJump = false; });
  hold($('btnUse'), ()=>{ touchUse = true; useCd = 0; }, ()=>{ touchUse = false; });
  $('btnSprint').addEventListener('touchstart', e => { e.preventDefault(); sprintToggle = !sprintToggle; $('btnSprint').classList.toggle('on', sprintToggle); }, {passive:false});
  $('btnInv').addEventListener('touchstart', e => { e.preventDefault(); if(menuHidden && player.alive) toggleInv(); }, {passive:false});
}

function toggleFullscreen(){
  try{
    const d = document.documentElement;
    if(!document.fullscreenElement && !document.webkitFullscreenElement){
      const f = d.requestFullscreen || d.webkitRequestFullscreen;
      if(f){ const p = f.call(d); if(p && p.catch) p.catch(()=>toast('Fullscreen is blocked here. On iPhone use Share > Add to Home Screen.', 3500)); }
      else toast('Fullscreen not supported here. On iPhone use Share > Add to Home Screen.', 3500);
    } else {
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
    }
  }catch(err){}
}
