<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Voxel Survival</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root { --slot:46px; --icon:34px; --heart:22px; }
  body.touch { --slot:36px; --icon:28px; --heart:17px; }
  html, body { margin:0; padding:0; overflow:hidden; width:100%; height:100%; background:#87CEEB; font-family:'Segoe UI',Arial,sans-serif; touch-action:none; -webkit-user-select:none; user-select:none; -webkit-touch-callout:none; -webkit-tap-highlight-color:transparent; }
  #canvas { display:block; width:100%; height:100%; touch-action:none; }

  #crosshair { position:absolute; top:50%; left:50%; width:20px; height:20px; margin:-10px 0 0 -10px; pointer-events:none; z-index:10; mix-blend-mode:difference; }
  #crosshair::before, #crosshair::after { content:''; position:absolute; background:#fff; }
  #crosshair::before { left:9px; top:0; width:2px; height:20px; }
  #crosshair::after { top:9px; left:0; width:20px; height:2px; }
  #mineBar { position:absolute; top:calc(50% + 18px); left:50%; width:60px; height:5px; margin-left:-30px; background:rgba(0,0,0,.5); border:1px solid rgba(255,255,255,.6); z-index:10; display:none; pointer-events:none; }
  #mineFill { height:100%; width:0; background:#fff; }

  #vignette { position:absolute; inset:0; pointer-events:none; z-index:5; background:radial-gradient(ellipse at center, rgba(0,0,0,0) 55%, rgba(0,0,0,0.35) 100%); }
  #waterOverlay { position:absolute; inset:0; pointer-events:none; z-index:6; background:rgba(25,70,190,0.38); display:none; }
  #portalOverlay { position:absolute; inset:0; pointer-events:none; z-index:6; background:radial-gradient(circle, rgba(170,70,255,.7), rgba(80,20,160,.9)); opacity:0; }
  #damageFlash { position:absolute; inset:0; pointer-events:none; z-index:7; background:rgba(200,0,0,0.45); opacity:0; transition:opacity .35s; }

  #hud { position:absolute; bottom:calc(10px + env(safe-area-inset-bottom)); left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:4px; z-index:12; user-select:none; pointer-events:none; }
  .barRow { display:flex; gap:2px; min-height:4px; }
  .icon { width:var(--heart); height:var(--heart); }
  .icon svg { width:100%; height:100%; display:block; filter:drop-shadow(0 1px 0 rgba(0,0,0,.6)); }
  #blockName { color:#fff; font-size:14px; text-shadow:1px 1px 2px #000; height:18px; transition:opacity .5s; letter-spacing:.5px; }

  #hotbar { pointer-events:auto; display:flex; gap:3px; background:rgba(0,0,0,0.4); padding:4px; border-radius:6px; border:2px solid rgba(255,255,255,0.2); backdrop-filter:blur(3px); }
  .slot { width:var(--slot); height:var(--slot); background:rgba(255,255,255,0.08); border:2px solid rgba(255,255,255,0.25); border-radius:4px; display:flex; align-items:center; justify-content:center; position:relative; box-sizing:border-box; }
  .slot.selected { border-color:#fff; box-shadow:0 0 10px rgba(255,255,255,0.8); background:rgba(255,255,255,0.22); transform:translateY(-4px); }
  .slot.held { border-color:#ffd54a; background:rgba(255,213,74,.25); }
  .slot img { width:var(--icon); height:var(--icon); image-rendering:pixelated; pointer-events:none; }
  .slot .count { position:absolute; bottom:0; right:3px; font-size:11px; color:#fff; text-shadow:1px 1px 1px #000; font-weight:bold; }
  .slot .key { position:absolute; top:0; left:3px; font-size:9px; color:rgba(255,255,255,.6); }

  #topLeft { position:absolute; top:calc(10px + env(safe-area-inset-top)); left:10px; color:#fff; z-index:10; text-shadow:1px 1px 2px #000; font-size:12px; user-select:none; background:rgba(0,0,0,0.3); padding:6px 10px; border-radius:6px; pointer-events:none; }
  #topLeft div { margin:2px 0; }
  #hint { position:absolute; top:12px; right:12px; color:#fff; z-index:10; text-shadow:1px 1px 2px #000; font-size:12px; background:rgba(0,0,0,0.3); padding:8px 12px; border-radius:6px; max-width:240px; line-height:1.5; pointer-events:none; }
  body.touch #hint { display:none; }

  #toast { position:absolute; top:18%; left:50%; transform:translateX(-50%); z-index:30; color:#fff; font-size:17px; font-weight:600; text-shadow:2px 2px 3px #000; background:rgba(0,0,0,.45); padding:8px 16px; border-radius:6px; opacity:0; transition:opacity .4s; pointer-events:none; text-align:center; max-width:88vw; }

  #bossBar { position:absolute; top:calc(14px + env(safe-area-inset-top)); left:50%; transform:translateX(-50%); width:min(420px,60vw); z-index:20; display:none; text-align:center; color:#fff; font-weight:700; text-shadow:1px 1px 2px #000; pointer-events:none; }
  #bossFill { height:10px; background:#b02bd6; width:100%; transition:width .2s; }
  #bossBack { background:rgba(0,0,0,.6); border:2px solid #222; margin-top:3px; }

  #menu { position:absolute; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; background:rgba(20,30,20,0.85); z-index:100; color:#fff; text-align:center; padding:16px; box-sizing:border-box; overflow:auto; }
  #menu h1 { font-size:clamp(28px,7vw,44px); margin:0 0 6px; text-shadow:3px 3px 0 #000; letter-spacing:2px; }
  #menu p { max-width:520px; line-height:1.5; color:#ddd; font-size:14px; margin:6px 0; }
  #menu button { margin-top:18px; padding:14px 34px; font-size:18px; background:#5c9e31; color:#fff; border:3px solid #3f6e21; border-radius:4px; cursor:pointer; font-weight:bold; }
  #menu button:hover { background:#6db43a; }

  #deathScreen, #victory { position:absolute; top:0; left:0; width:100%; height:100%; display:none; align-items:center; justify-content:center; flex-direction:column; z-index:100; color:#fff; text-align:center; }
  #deathScreen { background:rgba(120,0,0,0.75); }
  #victory { background:rgba(60,0,90,.55); pointer-events:none; z-index:90; }
  #deathScreen h1, #victory h1 { font-size:clamp(30px,8vw,48px); text-shadow:3px 3px 0 #000; margin:0 0 8px; }
  #deathScreen button { margin-top:20px; padding:14px 34px; font-size:18px; background:#aa2222; color:#fff; border:3px solid #661111; border-radius:4px; cursor:pointer; font-weight:bold; }
  #pause { position:absolute; top:45%; left:50%; transform:translate(-50%,-50%); z-index:40; color:#fff; background:rgba(0,0,0,.55); padding:14px 24px; border-radius:8px; font-size:18px; display:none; pointer-events:none; }

  /* inventory / crafting */
  #invPanel { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); z-index:60; background:rgba(28,28,32,.96); border:3px solid #555; border-radius:8px; padding:12px; color:#fff; max-width:94vw; max-height:90vh; overflow:auto; display:none; touch-action:pan-y; }
  #invPanel h2 { margin:0 0 6px; font-size:16px; }
  #invTop { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
  #invClose { background:#aa3333; border:2px solid #661111; color:#fff; font-weight:bold; padding:6px 12px; border-radius:4px; cursor:pointer; }
  #invGrid { display:grid; grid-template-columns:repeat(9,var(--slot)); gap:3px; }
  #recipes { margin-top:10px; display:flex; flex-direction:column; gap:5px; }
  .rec { display:flex; align-items:center; gap:8px; background:rgba(255,255,255,.07); padding:4px 8px; border-radius:5px; font-size:13px; }
  .rec img { width:28px; height:28px; image-rendering:pixelated; }
  .rec .info { flex:1; line-height:1.25; }
  .rec .cost { font-size:11px; color:#bbb; }
  .rec button { background:#4a8a2a; border:2px solid #2f5e17; color:#fff; font-weight:bold; padding:5px 10px; border-radius:4px; cursor:pointer; }
  .rec button:disabled { background:#444; border-color:#333; color:#888; cursor:default; }

  /* touch controls */
  #touchUI { display:none; }
  body.touch #touchUI { display:block; }
  #lookZone { position:absolute; inset:0; z-index:8; touch-action:none; }
  .tbtn { position:absolute; z-index:20; border-radius:50%; background:rgba(255,255,255,.18); border:2px solid rgba(255,255,255,.55); color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; touch-action:none; text-shadow:1px 1px 2px #000; }
  .tbtn.on { background:rgba(255,255,255,.45); }
  #joy { position:absolute; left:16px; bottom:calc(112px + env(safe-area-inset-bottom)); width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,.12); border:2px solid rgba(255,255,255,.4); z-index:20; touch-action:none; }
  #joyKnob { position:absolute; left:35px; top:35px; width:50px; height:50px; border-radius:50%; background:rgba(255,255,255,.45); pointer-events:none; }
  #btnAtk { right:16px; bottom:calc(128px + env(safe-area-inset-bottom)); width:78px; height:78px; font-size:30px; }
  #btnUse { right:104px; bottom:calc(108px + env(safe-area-inset-bottom)); width:62px; height:62px; }
  #btnJump { right:36px; bottom:calc(216px + env(safe-area-inset-bottom)); width:62px; height:62px; }
  #btnSprint { left:24px; bottom:calc(244px + env(safe-area-inset-bottom)); width:48px; height:48px; font-size:20px; }
  #btnInv { right:12px; top:calc(10px + env(safe-area-inset-top)); width:46px; height:46px; border-radius:10px; }
  #btnFull { right:12px; bottom:12px; width:46px; height:46px; border-radius:10px; z-index:150; cursor:pointer; }
  body.touch #btnFull { right:66px; bottom:auto; top:calc(10px + env(safe-area-inset-top)); }

/* ---------- polish ---------- */
html,body{font-family:'VT323','Courier New',monospace;}
.tbtn svg{width:30px;height:30px;pointer-events:none}
#topLeft{font-size:17px}
#hint{font-size:16px;line-height:1.25}
#toast{font-size:24px}
.slot .count{font-size:17px;font-weight:normal;text-shadow:2px 2px 0 #222}
.slot .key{font-size:13px}
#hotbar{background:rgba(24,24,24,.6);border:3px solid #141414;border-radius:2px;padding:3px;box-shadow:inset 0 0 0 2px rgba(255,255,255,.14)}
.slot{border-radius:0;border:2px solid #3a3a3a;background:rgba(139,139,139,.35)}
.slot.selected{border:3px solid #fff;box-shadow:none;transform:none;background:rgba(255,255,255,.22)}
#invPanel{background:#c6c6c6;border:4px solid;border-color:#fff #555 #555 #fff;outline:3px solid #151515;border-radius:0;color:#262626;font-size:19px}
#invPanel h2{font-size:24px;font-weight:normal}
#invPanel .slot{background:#8b8b8b;border:2px solid;border-color:#373737 #fff #fff #373737}
#invPanel .slot.held{background:#c9b24a}
#invClose{font-family:inherit;font-size:20px;background:#7a7a7a;border:3px solid;border-color:#bdbdbd #3a3a3a #3a3a3a #bdbdbd;color:#fff;border-radius:0}
.rec{background:#a9a9a9;color:#222;font-size:19px;border-radius:0}
.rec .cost{color:#3c3c3c;font-size:16px}
.rec button{font-family:inherit;font-size:19px;border-radius:0;background:#5b8f36;border:3px solid;border-color:#9ad36d #2d5418 #2d5418 #9ad36d}
.rec button:disabled{background:#777;border-color:#999 #555 #555 #999;color:#bbb}
#armorRow{display:flex;gap:3px;align-items:center;margin-bottom:8px}
#armorRow .def{margin-left:10px;font-size:19px}
.gameTitle{position:relative;font-family:'Press Start 2P','Courier New',monospace;font-size:clamp(20px,6vw,50px);letter-spacing:2px;color:#d6d6d6;text-align:center;text-shadow:-4px 0 #111,4px 0 #111,0 -4px #111,0 4px #111,-4px -4px #111,4px -4px #111,-4px 4px #111,4px 4px #111,0 8px 0 #4a4a4a,4px 8px 0 #111,-4px 8px 0 #111;margin-bottom:6px}
#menu{background:rgba(12,20,12,.55)}
#menu p{font-size:20px;line-height:1.2}
#menu button,#deathScreen button{font-family:'VT323',monospace;font-size:28px;min-width:280px;padding:6px 20px;color:#fff;text-shadow:2px 2px 0 #3f3f3f;background:#7a7a7a;border:3px solid;border-color:#bdbdbd #3a3a3a #3a3a3a #bdbdbd;outline:2px solid #000;border-radius:0;cursor:pointer;margin-top:14px;font-weight:normal}
#menu button:hover{background:#6e82bd}
#deathScreen button{background:#8a3a3a}
#deathScreen h1,#victory h1{font-family:'Press Start 2P','Courier New',monospace;font-weight:normal;font-size:clamp(22px,5vw,38px)}
#deathScreen p,#victory p{font-size:24px}
#pause{font-size:26px;border-radius:0}
#bossBar{font-size:22px;font-weight:normal}
#loading{position:absolute;inset:0;z-index:300;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:30px;overflow:hidden;background:#6fa9ee;font-family:'VT323',monospace}
#loadBg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;image-rendering:pixelated;filter:blur(2px) brightness(.93);transform:scale(1.05)}
#loadPanel{position:relative;width:min(580px,90vw);background:#c6c6c6;border:4px solid;border-color:#fff #555 #555 #fff;outline:3px solid #151515;padding:6px 8px 10px;box-shadow:0 8px 0 rgba(0,0,0,.35)}
#loadHead{text-align:center;color:#444;font-size:26px;padding:0 0 6px}
#loadBox{background:#1c1c1c;border:3px solid #0d0d0d;padding:16px 18px 18px;min-height:130px;display:flex;flex-direction:column;justify-content:space-between;gap:16px}
#loadTip{color:#fff;font-size:26px;line-height:1.1;text-align:center;min-height:58px}
#loadBar{height:14px;background:repeating-linear-gradient(90deg,#2a3a2a 0 14px,#101010 14px 16px);border:2px solid #000}
#loadFill{height:100%;width:0;background:repeating-linear-gradient(90deg,#6bdc3c 0 14px,#2f7a1c 14px 16px);transition:width .15s}
#errBox{position:absolute;left:8px;right:8px;bottom:8px;z-index:999;background:rgba(160,0,0,.92);color:#fff;font:14px monospace;padding:8px;display:none;white-space:pre-wrap;max-height:40vh;overflow:auto}

/* ---- professional pass ---- */
body{font-family:ui-monospace,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace}
.logo{font-family:Impact,"Arial Black",Haettenschweiler,sans-serif;font-size:clamp(40px,11vw,92px);letter-spacing:.05em;color:#cfcfcf;-webkit-text-stroke:2px #151515;paint-order:stroke fill;text-shadow:0 1px 0 #9a9a9a,0 2px 0 #8a8a8a,0 3px 0 #7a7a7a,0 4px 0 #6a6a6a,0 5px 0 #5a5a5a,0 6px 0 #4a4a4a,0 7px 0 #3a3a3a,0 14px 16px rgba(0,0,0,.55);text-align:center;line-height:1;margin:0}
.logoSub{color:#ffe36b;font-size:14px;font-weight:700;letter-spacing:.22em;text-shadow:2px 2px 0 #3a3000;margin:10px 0 22px;transform:rotate(-2deg)}
#menu{background:rgba(8,14,10,.38);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
#menu .mcbtn,#deathScreen .mcbtn{display:block;width:min(340px,80vw);margin:8px auto 0;padding:12px 16px;font:700 17px ui-monospace,Menlo,Consolas,monospace;color:#fff;text-shadow:2px 2px 0 #3c3c3c;background:#7d7d7d;border:2px solid #000;box-shadow:inset -3px -4px 0 #4f4f4f,inset 3px 3px 0 #b4b4b4;cursor:pointer;border-radius:0}
#menu .mcbtn:hover,#menu .mcbtn:active,#deathScreen .mcbtn:hover{background:#6b78b8;box-shadow:inset -3px -4px 0 #3f4a85,inset 3px 3px 0 #a3b0ee}
#menuControls{background:rgba(0,0,0,.5);padding:10px 14px;border:2px solid #000;max-width:480px;font-size:12px;margin-top:4px}
body.inmenu #hud,body.inmenu #topLeft,body.inmenu #hint,body.inmenu #crosshair,body.inmenu #touchUI{display:none!important}
#hotbar{border-radius:0;background:rgba(24,24,24,.72);border:3px solid #0d0d0d;padding:3px;gap:2px}
.slot{border-radius:0;background:rgba(139,139,139,.35);border:2px solid #373737}
.slot.selected{border-color:#fff;box-shadow:0 0 0 2px #000;background:rgba(255,255,255,.2);transform:none}
#invPanel{background:#c6c6c6;border:3px solid #000;border-radius:0;box-shadow:inset 3px 3px 0 #fff,inset -3px -3px 0 #6b6b6b;color:#303030;padding:14px}
#invPanel h2{color:#3d3d3d}
#invPanel .slot{background:#8b8b8b;border:2px solid;border-color:#373737 #fff #fff #373737}
#invPanel .slot.held{background:#c9b04a}
#invPanel .slot.selected{box-shadow:inset 0 0 0 2px #fff}
#invPanel .slot .count{color:#fff}
.apts{margin-left:8px;font-size:12px}
.alabel{font-size:9px;color:#444;pointer-events:none}
.rec{background:#a8a8a8;border-radius:0;border:2px solid;border-color:#fff #6b6b6b #6b6b6b #fff;color:#222}
.rec .cost{color:#3a3a3a}
.rec button{background:#5fa02f;border:2px solid #000;box-shadow:inset -2px -3px 0 #3d6e1c,inset 2px 2px 0 #9be06a;border-radius:0;font-family:inherit;color:#fff;text-shadow:1px 1px #234}
.rec button:disabled{background:#8a8a8a;box-shadow:inset -2px -3px 0 #666,inset 2px 2px 0 #aaa;color:#ccc}
#invClose{background:#7d7d7d;border:2px solid #000;color:#fff;text-shadow:2px 2px #3c3c3c;box-shadow:inset -2px -3px 0 #4f4f4f,inset 2px 2px 0 #b4b4b4;border-radius:0;font-family:inherit}
#deathScreen h1,#victory h1{font-family:Impact,"Arial Black",sans-serif;letter-spacing:.04em}
.tbtn svg{width:56%;height:56%;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(1px 1px 1px #000)}
#toast,#topLeft,#hint{border-radius:0}

.mcinput{display:block;width:min(340px,80vw);box-sizing:border-box;margin:10px auto 0;padding:11px 12px;font:700 15px ui-monospace,Menlo,Consolas,monospace;background:#111;color:#fff;border:2px solid #000;box-shadow:inset 2px 2px 0 #333;border-radius:0;text-align:center;outline:none;-webkit-user-select:text;user-select:text}
.mcinput:focus{border-color:#8fb0ff}
#menu{justify-content:flex-start!important;touch-action:pan-y;-webkit-overflow-scrolling:touch;padding-bottom:30px}
#menu>:first-child{margin-top:auto}
#menu>:last-child{margin-bottom:auto}
#roomLabel{color:#9fffa0;font-weight:700}
</style>
</head>
<body class="inmenu">

<canvas id="canvas"></canvas>
<div id="vignette"></div>
<div id="waterOverlay"></div>
<div id="portalOverlay"></div>
<div id="damageFlash"></div>
<div id="crosshair"></div>
<div id="mineBar"><div id="mineFill"></div></div>

<div id="topLeft">
  <div id="fpsCounter">FPS: --</div>
  <div id="timeLabel">Time: Day</div>
  <div id="dimLabel">Overworld</div>
  <div id="roomLabel"></div>
  <div id="posLabel">Pos: 0, 0, 0</div>
</div>

<div id="hint">
  WASD move · Mouse look · Space jump / swim<br>
  Hold left click mine / attack · Right click place / eat / use<br>
  1-9 or wheel select · Shift sprint · E inventory &amp; crafting
</div>

<div id="toast"></div>
<div id="bossBar"><div id="bossName">Ender Dragon</div><div id="bossBack"><div id="bossFill"></div></div></div>

<div id="hud">
  <div id="blockName"></div>
  <div class="barRow" id="armorBar"></div>
  <div class="barRow" id="healthBar"></div>
