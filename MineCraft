function findSpawn(){
  for(let dx=-1; dx<=1; dx++) for(let dz=-1; dz<=1; dz++) getChunk(dx,dz,true);
  for(let i=0;i<200;i++){
    const wx = Math.round(8 + Math.cos(i*0.9)*i*0.8), wz = Math.round(8 + Math.sin(i*0.9)*i*0.8);
    const [cx,cz] = worldToChunk(wx,wz);
    getChunk(cx,cz,true);
    for(let y=WORLD_HEIGHT-1;y>0;y--){
      const b = getBlock(wx,y,wz);
      if(b===0 || isPlant(b)) continue;
      if(b===BLOCK.GRASS || b===BLOCK.SAND || b===BLOCK.STONE){ player.pos.set(wx+0.5, y+1.05, wz+0.5); return; }
      break;
    }
  }
  player.pos.set(8, 35, 8);
}

let lastTime = performance.now(), fpsCount = 0, fpsLast = performance.now();
const waterOverlay = $('waterOverlay');
let lastPosText = 0;

function animate(){
  requestAnimationFrame(animate);
  const now = performance.now();
  const dt = Math.min((now - lastTime)/1000, 0.05);
  lastTime = now;

  const running = isActive();
  moving = false;
  if(running){
    updatePhysics(dt);
    updateSurvival(dt);
    checkPortals(dt);
    updateActions(dt);
