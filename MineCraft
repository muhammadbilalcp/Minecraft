function newBuf(){ return { p:[], u:[], c:[], nrm:[], sw:[], i:[], n:0 }; }
function pushQuad(B, pts, uvs, cols, flip, nrm, sw){
  const b = B.n;
  for(let k=0;k<4;k++){
    B.p.push(pts[k][0], pts[k][1], pts[k][2]);
    B.u.push(uvs[k][0], uvs[k][1]);
    B.c.push(cols[k], cols[k], cols[k]);
    const nn = !nrm ? [0,1,0] : (Array.isArray(nrm[0]) ? nrm[k] : nrm);
    B.nrm.push(nn[0], nn[1], nn[2]);
    B.sw.push(sw ? sw[k] : 0);
  }
  if(flip) B.i.push(b+1,b+2,b+3, b+1,b+3,b);
  else B.i.push(b,b+1,b+2, b,b+2,b+3);
  B.n += 4;
}
