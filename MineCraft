function getChunk(cx, cz, create){
  const key = chunkKey(cx,cz);
  let c = chunks[key];
  if(!c && create){
    c = { data: generateChunk(cx,cz), mesh:null, waterMesh:null, plantMesh:null, portalMesh:null, emitMesh:null, dirty:true };
    chunks[key] = c;
  }
  return c;
}
function worldToChunk(wx, wz){ return [Math.floor(wx/CHUNK_SIZE), Math.floor(wz/CHUNK_SIZE)]; }
function chunkLoaded(wx,wz){ const [cx,cz] = worldToChunk(wx,wz); return !!getChunk(cx,cz,false); }
function getBlock(wx, wy, wz){
  if(wy < 0 || wy >= WORLD_HEIGHT) return BLOCK.AIR;
  const [cx,cz] = worldToChunk(wx,wz);
  const c = getChunk(cx,cz,false);
  if(!c) return BLOCK.AIR;
  const lx = ((wx % CHUNK_SIZE)+CHUNK_SIZE)%CHUNK_SIZE, lz = ((wz % CHUNK_SIZE)+CHUNK_SIZE)%CHUNK_SIZE;
  return c.data[idx(lx,wy,lz)];
}
function setBlock(wx, wy, wz, block){
  if(wy < 0 || wy >= WORLD_HEIGHT) return;
  const [cx,cz] = worldToChunk(wx,wz);
  const c = getChunk(cx,cz,true);
  const lx = ((wx % CHUNK_SIZE)+CHUNK_SIZE)%CHUNK_SIZE, lz = ((wz % CHUNK_SIZE)+CHUNK_SIZE)%CHUNK_SIZE;
  c.data[idx(lx,wy,lz)] = block;
  netEdit(wx,wy,wz,block);
  c.dirty = true;
  for(let dx=-1; dx<=1; dx++) for(let dz=-1; dz<=1; dz++){
    if(!dx && !dz) continue;
    const touchX = (dx===-1 && lx===0) || (dx===1 && lx===CHUNK_SIZE-1) || dx===0;
    const touchZ = (dz===-1 && lz===0) || (dz===1 && lz===CHUNK_SIZE-1) || dz===0;
    if(touchX && touchZ){ const n=getChunk(cx+dx,cz+dz,false); if(n) n.dirty = true; }
  }
}
