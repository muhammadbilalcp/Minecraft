  for(let x=0;x<W;x++){ const h = 62 + Math.sin(x*0.05)*5 + Math.sin(x*0.13)*3; g.fillStyle = '#5b9a45'; g.fillRect(x,h,1,H-h); }
  function canopy(cx,cy,w,h,a,b){ for(let y=0;y<h;y++) for(let x=0;x<w;x++){ if(r()<0.1) continue; g.fillStyle = r()<0.5 ? a : b; g.fillRect(cx+x,cy+y,1,1); } }
  g.fillStyle = '#6b4a2b'; g.fillRect(26,38,5,30); g.fillRect(154,40,5,28);
  canopy(8,12,42,28,'#4f9a3a','#3b7d2b'); canopy(138,18,48,26,'#4f9a3a','#3b7d2b');
  for(let y=66;y<H;y++) for(let x=0;x<W;x++){
    const d = (y-66)/(H-66), v = r();
    g.fillStyle = 'rgb('+Math.round(70+v*26-d*14)+','+Math.round(138+v*34-d*20)+','+Math.round(52+v*16)+')';
    g.fillRect(x,y,1,1);
  }
  for(let i=0;i<70;i++){
    const y = 70 + r()*(H-72), x = r()*W, s = 1 + (y-66)/12, col = r()<0.5 ? '#f2f2d0' : '#e84a5f';
    g.fillStyle = col; g.fillRect(x,y,s,s); g.fillRect(x-s,y+s*0.5,s,s*0.5); g.fillRect(x+s,y+s*0.5,s,s*0.5);
  }
}
async function boot(){
  try{
    drawLoadBg(); showLoading(true, 'Loading...');
    await sleep(); setLoad(0.02); await sleep();
    findSpawn();
    spawnPos = player.pos.clone();
    player.peak = player.pos.y;
    addItem(ITEM.APPLE, 3);
    updateHudUI(); updateHotbarUI(); refreshHand();
    loadingBusy = true;
    await loadAround();
    for(let i=0;i<8;i++) spawnPassiveNear(6, 32);
    camera.position.set(player.pos.x, player.pos.y+PLAYER_HEIGHT*0.9, player.pos.z);
    await sleep();
    loadingBusy = false;
    showLoading(false);
    animate();
  }catch(e){
    console.error(e);
    $('loadTip').textContent = 'Error: ' + e.message;
  }
}
boot();

})();
</script>
