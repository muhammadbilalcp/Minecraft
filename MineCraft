    case 'creeper': {
      const gr = 0x4fb04f;
      mob.legs = [b.limb(g,.24,.4,.24,gr,-.13,.4,.17), b.limb(g,.24,.4,.24,gr,.13,.4,.17), b.limb(g,.24,.4,.24,gr,-.13,.4,-.17), b.limb(g,.24,.4,.24,gr,.13,.4,-.17)];
      b.box(g,.5,.8,.3,gr,0,.8,0); b.box(g,.5,.5,.5,gr,0,1.45,0);
      b.box(g,.12,.12,.04,0x111111,-.12,1.5,.26,true); b.box(g,.12,.12,.04,0x111111,.12,1.5,.26,true);
      b.box(g,.1,.2,.04,0x111111,0,1.33,.26,true);
      break; }
    case 'blaze': {
      b.box(g,.5,.5,.5,0xf0c030,0,1.5,0,true);
