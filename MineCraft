  waterOverlay.style.background = inLavaCam ? 'rgba(220,70,0,0.75)' : 'rgba(25,70,190,0.38)';
  const fogNear = currentDim === 'overworld' ? 34 : (currentDim === 'nether' ? 6 : 24);
  const fogFar = currentDim === 'nether' ? Math.min(FOG_FAR, 56) : FOG_FAR;
  scene.fog.near = (underwater||inLavaCam) ? 1 : fogNear;
  scene.fog.far = inLavaCam ? 4 : (underwater ? 20 : fogFar);

  updateDayNight(running ? dt : 0);
  netTick(dt);
  worldUniforms.uTime.value = now*0.001;
  worldUniforms.uFogColor.value.copy(scene.fog.color); worldUniforms.uFogNear.value = scene.fog.near; worldUniforms.uFogFar.value = scene.fog.far;
  updateChunks(3);
  if(currentDim === 'overworld') updateClouds(dt);
  updateParticles(dt);
  updateHand(dt, moving);
  portalMat.opacity = 0.7 + Math.sin(now*0.004)*0.12;

  waterTex.offset.x = (waterTex.offset.x + dt*0.04) % 1;
  waterTex.offset.y = (waterTex.offset.y + dt*0.025) % 1;

  if(running){
    target = pickTarget();
    if(target && target.kind === 'block'){ highlight.visible = true; highlight.position.set(target.hit.x+0.5, target.hit.y+0.5, target.hit.z+0.5); }
    else highlight.visible = false;
  } else { target = null; highlight.visible = false; }

  if(now - lastPosText > 200){
    lastPosText = now;
    $('posLabel').textContent = 'Pos: ' + player.pos.x.toFixed(1) + ', ' + player.pos.y.toFixed(1) + ', ' + player.pos.z.toFixed(1);
  }
  $('pause').style.display = (!IS_TOUCH && menuHidden && player.alive && !uiOpen && !locked && !loadingBusy) ? 'block' : 'none';
  fpsCount++;
  if(now - fpsLast > 500){
    $('fpsCounter').textContent = 'FPS: ' + Math.round(fpsCount*1000/(now-fpsLast));
    fpsCount = 0; fpsLast = now;
  }

  renderer.clear();
  renderer.render(scene, camera);
  renderer.clearDepth();
  if(menuHidden) renderer.render(handScene, handCam);
}

