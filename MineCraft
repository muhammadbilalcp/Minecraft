  <div id="lookZone"></div>
  <div id="joy"><div id="joyKnob"></div></div>
  <div class="tbtn" id="btnAtk"><svg viewBox="0 0 24 24"><path d="M3 21L14 10" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/><path d="M6 7c3-3.5 9-4.5 13-1-3.5 0-6 1-8 3z" fill="#fff"/></svg></div>
  <div class="tbtn" id="btnUse"><svg viewBox="0 0 24 24"><path d="M12 3l8 4v10l-8 4-8-4V7z" fill="none" stroke="#fff" stroke-width="2"/><path d="M12 12l8-5M12 12v9M12 12L4 7" stroke="#fff" stroke-width="1.6" fill="none"/></svg></div>
