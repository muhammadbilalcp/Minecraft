function netTick(dt){
  for(const id in remotes){
    const r = remotes[id], k = Math.min(1, dt*10), ox = r.pos.x, oz = r.pos.z;
    r.pos.x += (r.tx - r.pos.x)*k; r.pos.y += (r.ty - r.pos.y)*k; r.pos.z += (r.tz - r.pos.z)*k;
    let dy = r.tyaw - r.yaw; while(dy > Math.PI) dy -= Math.PI*2; while(dy < -Math.PI) dy += Math.PI*2;
    r.yaw += dy*k;
    r.group.position.copy(r.pos); r.group.rotation.y = r.yaw;
    r.group.visible = (r.d === currentDim);
    const sp = Math.min(1, Math.hypot(r.pos.x-ox, r.pos.z-oz)/Math.max(dt,0.001)/4);
    r.t += dt*9; const sw = Math.sin(r.t)*0.8*sp;
