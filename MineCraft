function chunkKey(cx,cz){ return cx+","+cz; }
function idx(x,y,z){ return (y*CHUNK_SIZE + z)*CHUNK_SIZE + x; }

function genHeight(wx, wz){
  const h = noise2D(wx, wz, 4, 0.02, 0.5);
  const base = 4 + h*30;
  return Math.max(2, Math.min(WORLD_HEIGHT-10, Math.floor(base)));
}

function genOverworld(cx, cz){
  const rnd = rng32((cx*73856093) ^ (cz*19349663) ^ WORLD_SEED);
  const data = new Uint8Array(CHUNK_SIZE * WORLD_HEIGHT * CHUNK_SIZE);
  const heights = [];
  for(let x=0; x<CHUNK_SIZE; x++){
    for(let z=0; z<CHUNK_SIZE; z++){
      const wx = cx*CHUNK_SIZE + x, wz = cz*CHUNK_SIZE + z;
      const h = genHeight(wx, wz);
      heights[x*CHUNK_SIZE+z] = h;
      for(let y=0; y<WORLD_HEIGHT; y++){
        let b = BLOCK.AIR;
        if(y===0) b = BLOCK.BEDROCK;
        else if(y < h-4) b = BLOCK.STONE;
        else if(y < h-1) b = (h > 27) ? BLOCK.STONE : BLOCK.DIRT;
        else if(y === h-1) b = (h <= SEA+1) ? BLOCK.SAND : (h > 27 ? BLOCK.STONE : BLOCK.GRASS);
        else if(y < SEA && y >= h) b = BLOCK.WATER;
        data[idx(x,y,z)] = b;
      }
      // caves
      const carveTop = h > SEA+2 ? h-1 : h-5;
      for(let y=3; y<=carveTop; y++){
        const n1 = noise3(wx*0.07, y*0.1, wz*0.07, 11+WORLD_SEED), n2 = noise3(wx*0.07+50, y*0.1, wz*0.07+50, 23+WORLD_SEED);
        if(Math.abs(n1-0.5) < 0.055 && Math.abs(n2-0.5) < 0.055){
          data[idx(x,y,z)] = y <= 4 ? BLOCK.LAVA : BLOCK.AIR;
        }
      }
      if(rnd() < 0.04){
        const cy = 3 + Math.floor(rnd()*Math.max(1,h-8));
        if(cy < h-4 && data[idx(x,cy,z)] === BLOCK.STONE) data[idx(x,cy,z)] = BLOCK.COAL;
      }
      if(rnd() < 0.035){
        const iy = 3 + Math.floor(rnd()*Math.max(1,Math.min(16,h-8)));
        if(iy < h-4 && data[idx(x,iy,z)] === BLOCK.STONE){
          data[idx(x,iy,z)] = BLOCK.IRON;
          if(x < CHUNK_SIZE-1 && rnd() < 0.6 && data[idx(x+1,iy,z)] === BLOCK.STONE) data[idx(x+1,iy,z)] = BLOCK.IRON;
        }
      }
    }
  }
  // trees
  for(let x=2; x<CHUNK_SIZE-2; x++){
    for(let z=2; z<CHUNK_SIZE-2; z++){
      const h = heights[x*CHUNK_SIZE+z];
      if(h > SEA+2 && h <= 27 && rnd() < 0.012 && data[idx(x,h-1,z)] === BLOCK.GRASS){
        const trunkH = 4 + Math.floor(rnd()*3);
        for(let ty=0; ty<trunkH; ty++){ const y = h+ty; if(y < WORLD_HEIGHT) data[idx(x,y,z)] = BLOCK.WOOD; }
        const topY = h+trunkH;
        for(let lx=-2; lx<=2; lx++) for(let lz=-2; lz<=2; lz++) for(let ly=-2; ly<=1; ly++){
          const dist = Math.abs(lx)+Math.abs(lz)+Math.abs(ly);
          if(dist <= 3 && rnd() > 0.1){
            const yy = topY+ly, xx = x+lx, zz = z+lz;
            if(xx>=0 && xx<CHUNK_SIZE && zz>=0 && zz<CHUNK_SIZE && yy>=0 && yy<WORLD_HEIGHT){
              if(data[idx(xx,yy,zz)] === BLOCK.AIR) data[idx(xx,yy,zz)] = BLOCK.LEAVES;
            }
          }
        }
      }
    }
  }
  // plants
  for(let x=0; x<CHUNK_SIZE; x++){
    for(let z=0; z<CHUNK_SIZE; z++){
      const h = heights[x*CHUNK_SIZE+z];
      if(h > SEA+1 && h <= 27 && h < WORLD_HEIGHT && data[idx(x,h-1,z)] === BLOCK.GRASS && data[idx(x,h,z)] === BLOCK.AIR){
        const r = rnd();
        if(r < 0.012) data[idx(x,h,z)] = BLOCK.FLOWER_R;
        else if(r < 0.024) data[idx(x,h,z)] = BLOCK.FLOWER_Y;
        else if(r < 0.14) data[idx(x,h,z)] = BLOCK.TALLGRASS;
      }
    }
  }
  return data;
}

function genNether(cx, cz){
  const rnd = rng32((cx*73856093) ^ (cz*19349663) ^ (7777 + WORLD_SEED));
  const data = new Uint8Array(CHUNK_SIZE * WORLD_HEIGHT * CHUNK_SIZE);
  for(let x=0; x<CHUNK_SIZE; x++){
    for(let z=0; z<CHUNK_SIZE; z++){
      const wx = cx*CHUNK_SIZE + x, wz = cz*CHUNK_SIZE + z;
      const fh = 3 + Math.floor(noise2D(wx+500, wz+500, 3, 0.035, 0.5)*18);
      const ch = 38 - Math.floor(noise2D(wx-300, wz-300, 3, 0.035, 0.5)*12);
      for(let y=0; y<WORLD_HEIGHT; y++){
        let b = 0;
        if(y===0 || y>=WORLD_HEIGHT-2) b = BLOCK.BEDROCK;
        else if(y < fh || y > ch) b = BLOCK.NETHERRACK;
        else if(y < 9) b = BLOCK.LAVA;
        data[idx(x,y,z)] = b;
      }
      if(rnd() < 0.014){
        data[idx(x,ch+1,z)] = BLOCK.GLOWSTONE;
        if(rnd() < 0.5 && ch > fh+3) data[idx(x,ch,z)] = BLOCK.GLOWSTONE;
      }
    }
  }
  return data;
}

const END_R = 40;
const END_PILLARS = [];
for(let i=0;i<8;i++){ const a = i/8*Math.PI*2; END_PILLARS.push({ x:Math.round(Math.cos(a)*22), z:Math.round(Math.sin(a)*22), h:10+((i*5)%4)*3 }); }
function endShape(wx,wz){
  const d = Math.hypot(wx,wz);
  const R = END_R + noise2D(wx+7, wz+7, 2, 0.05, 0.5)*8 - 4;
  if(d > R) return null;
  return { top: 24 + Math.floor(noise2D(wx+99, wz+99, 2, 0.08, 0.5)*2), thick: 4 + Math.floor((1-d/R)*10) };
}
function genEnd(cx, cz){
  const data = new Uint8Array(CHUNK_SIZE * WORLD_HEIGHT * CHUNK_SIZE);
  for(let x=0; x<CHUNK_SIZE; x++){
    for(let z=0; z<CHUNK_SIZE; z++){
      const wx = cx*CHUNK_SIZE + x, wz = cz*CHUNK_SIZE + z;
      const s = endShape(wx,wz);
      if(!s) continue;
      for(let y=Math.max(1,s.top-s.thick); y<s.top; y++) data[idx(x,y,z)] = BLOCK.ENDSTONE;
      for(const p of END_PILLARS){
        if(Math.abs(wx-p.x)<=1 && Math.abs(wz-p.z)<=1){
          for(let y=s.top; y<s.top+p.h && y<WORLD_HEIGHT-1; y++) data[idx(x,y,z)] = BLOCK.OBSIDIAN;
          if(s.top+p.h < WORLD_HEIGHT) data[idx(x,s.top+p.h,z)] = BLOCK.GLOWSTONE;
        }
      }
    }
  }
  return data;
}

function generateChunk(cx,cz){
  if(currentDim === 'nether') return genNether(cx,cz);
  if(currentDim === 'end') return genEnd(cx,cz);
  return genOverworld(cx,cz);
}
