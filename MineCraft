    const e = [dx*dx+dz*dz, pc[0]+dx, pc[1]+dz];
    gen.push(e); if(Math.abs(dx)<=R && Math.abs(dz)<=R) msh.push(e);
  }
  gen.sort((a,b)=>a[0]-b[0]); msh.sort((a,b)=>a[0]-b[0]);
  const total = gen.length + msh.length; let done = 0;
  for(const g of gen){ getChunk(g[1], g[2], true); if(++done % 3 === 0){ setLoad(done/total); await sleep(); } }
  for(const m of msh){ const c = getChunk(m[1], m[2], true); if(c.dirty) buildChunkMesh(m[1], m[2]); if(++done % 3 === 0){ setLoad(done/total); await sleep(); } }
