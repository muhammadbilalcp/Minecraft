function builder(mob){
  return {
    box(parent,w,h,d,color,x,y,z,glow){
      const m = glow ? new THREE.MeshBasicMaterial({ color }) : new THREE.MeshLambertMaterial({ color });
      const mesh = new THREE.Mesh(mobBoxGeo, m);
      mesh.scale.set(w,h,d); mesh.position.set(x,y,z); mesh.castShadow = !glow;
      parent.add(mesh); mob.mats.push({ m, base:new THREE.Color(color), glow:!!glow });
      return mesh;
    },
    limb(parent,w,h,d,color,x,y,z){
      const piv = new THREE.Group(); piv.position.set(x,y,z); parent.add(piv);
      this.box(piv,w,h,d,color,0,-h/2,0);
      return piv;
    }
  };
}
